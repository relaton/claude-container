#!/usr/bin/env bash
#
# cwl — launch the Claude workflow for ONE ribose project WITHOUT Docker.
#
# Usage:
#   cd ribose/<org>/<repo> && cwl ["task description"]   # derive repo from $PWD
#   cwl <org>/<repo> ["task description"]                 # explicit repo
#
# Host-native counterpart to `cw`. The container's boundary is a mount namespace;
# here it is two layers:
#
#   Bash and every process it spawns  -> Claude Code's built-in sandbox (Seatbelt on
#     macOS). Kernel-enforced: writes are confined to the target repo, reads to the
#     workspace plus a short toolchain allowlist, and network egress to an allowlist.
#   Read / Edit / Write / MCP / hooks -> permission rules. These run inside the Claude
#     Code process and are NOT covered by the sandbox, so the generated deny list below
#     closes them off explicitly.
#
# Because the file tools are gated by the permission layer rather than the kernel, this
# does NOT pass --allow-dangerously-skip-permissions the way `cw` does — that flag would
# skip the very deny rules doing the work. Bash still runs prompt-free, via the sandbox's
# auto-allow, which is where nearly all the prompts came from anyway.
#
# The earlier sandbox-runtime (`srt`) version of this launcher was abandoned: srt's
# Seatbelt profile denies tcsetattr on the real controlling terminal, so Claude Code
# cannot enter raw mode and the interactive TUI is unusable. See README.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"      # .../ribose/claude-container
RIBOSE_ROOT="$(cd "${COMPOSE_DIR}/.." && pwd)"     # .../ribose

die() { echo "cwl: $*" >&2; exit 1; }

# --- resolve the target repo (org/repo) -------------------------------------
# Same contract as `cw`, so the two launchers are interchangeable.
target=""
# The pattern is deliberately narrow: exactly two path segments of the characters
# GitHub allows in a name. A task description that holds a slash — a URL, for
# example — must not look like a repo name here.
if [[ $# -ge 1 && "$1" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
  # An explicit org/repo that does not exist is a typo, not part of the task
  # description — fail loudly instead of silently falling back to $PWD.
  [[ -d "${RIBOSE_ROOT}/$1" ]] || die "no such project: ${RIBOSE_ROOT}/$1"
  target="$1"; shift
elif [[ "${PWD}/" == "${RIBOSE_ROOT}/"* ]]; then
  rel="${PWD#"${RIBOSE_ROOT}"/}"
  target="$(printf '%s' "$rel" | cut -d/ -f1-2)"
else
  die "run from inside a ribose project dir, or pass <org>/<repo> explicitly.
     e.g.  cd ${RIBOSE_ROOT}/relaton/relaton-bib && cwl \"add retry logic\""
fi

org="${target%%/*}"
repo="${target#*/}"
[[ -n "$org" && -n "$repo" && "$org" != "$target" ]] \
  || die "could not resolve <org>/<repo> from '${target}'."
[[ "$org" != "claude-container" ]] \
  || die "claude-container is the tooling dir, not a project to work on."
[[ -d "${RIBOSE_ROOT}/${target}/.git" || -f "${RIBOSE_ROOT}/${target}/.git" ]] \
  || die "${target} is not a git repo (${RIBOSE_ROOT}/${target})."

task="$*"
repo_path="${RIBOSE_ROOT}/${target}"

command -v jq >/dev/null 2>&1 || die "jq not found (brew install jq)."

# --- shared hand-off inbox ---------------------------------------------------
# Exported so image/commands/feature.md can name one path under both launchers
# (/work/HANDOFFS in the container, the real host path here).
export CW_HANDOFFS="${RIBOSE_ROOT}/HANDOFFS"
mkdir -p "${CW_HANDOFFS}"

# --- worktree drop queue -----------------------------------------------------
# A cwl session cannot remove a worktree itself. Claude Code denies every write to
# .git/worktrees/<id>/commondir for each worktree that exists when the session starts,
# and it takes that list again when the session enters a worktree. Its sandbox also
# denies unlink on each parent of a denied path, so `git worktree remove` fails with
# "Operation not permitted". /feature therefore appends the drops the user approved to
# this queue, and process_drops below runs them outside the sandbox, after a second
# confirmation on the terminal. One line per drop:
#   <worktree path> TAB <branch> TAB merged|unmerged
# The third field carries the gh evidence, because only it may escalate to `branch -D`.
export CW_DROPS="${CW_HANDOFFS}/drops/${org}__${repo}.tsv"
mkdir -p "${CW_HANDOFFS}/drops"

# --- GitHub auth -------------------------------------------------------------
# The host keeps its gh token in the macOS keyring, not in a file, so materialise it.
export GH_TOKEN="${GH_TOKEN:-$(gh auth token 2>/dev/null || true)}"
[[ -z "${GH_TOKEN}" ]] && echo "cwl: warning — no GH_TOKEN (run 'gh auth login'); pushes will fail." >&2

# Replicate entrypoint.sh's git setup WITHOUT writing to ~/.gitconfig: rewrite SSH
# remotes to HTTPS and authenticate them with GH_TOKEN. This is what lets us deny
# read access to ~/.ssh below while leaving fetch/push working, exactly as in the
# container (which never had the host's SSH keys either). An empty first value resets
# the inherited helper chain so the host's osxkeychain helper — which cannot reach the
# keychain from inside the sandbox — is not consulted.
export GIT_CONFIG_COUNT=3
export GIT_CONFIG_KEY_0="credential.helper"
export GIT_CONFIG_VALUE_0=""
export GIT_CONFIG_KEY_1="url.https://github.com/.insteadOf"
export GIT_CONFIG_VALUE_1="git@github.com:"
export GIT_CONFIG_KEY_2="credential.https://github.com.helper"
export GIT_CONFIG_VALUE_2='!f() { echo username=x-access-token; echo password=$GH_TOKEN; }; f'

# --- skip the folder-trust prompt for this repo ------------------------------
# entrypoint.sh does this inside the container; it is needed on the host too, because
# trust is stored PER PROJECT DIRECTORY, so a repo you have never opened still prompts.
# Onboarding is already done on the host, so only the per-project flag is set.
claude_json="${HOME}/.claude.json"
[[ -f "${claude_json}" ]] || echo '{}' > "${claude_json}"
if ! jq -e --arg dir "${repo_path}" \
      '.projects[$dir].hasTrustDialogAccepted == true' "${claude_json}" >/dev/null 2>&1; then
  seed_tmp="$(mktemp "${TMPDIR:-/tmp}/cwl-claudejson-XXXXXX")"
  if jq --arg dir "${repo_path}" '
        .projects = (.projects // {})
        | .projects[$dir] = ((.projects[$dir] // {}) + {hasTrustDialogAccepted: true})
      ' "${claude_json}" > "${seed_tmp}"; then
    mv "${seed_tmp}" "${claude_json}"
    echo "cwl: trusted ${target} (folder-trust prompt pre-accepted)" >&2
  else
    rm -f "${seed_tmp}"
    echo "cwl: warning — could not seed folder trust; you may get a prompt." >&2
  fi
fi

# --- read boundary -----------------------------------------------------------
# The container got its read boundary for free: only /work was mounted, so nothing else
# on the host existed. Here the process runs on the real filesystem, so the boundary has
# to be stated. Everything under /Users and /Volumes is denied except the workspace and
# the paths a session genuinely needs: the Ruby toolchain (asdf/rvm hold the interpreter
# AND the installed gems), Claude Code's own binary and state, and the shell/git/gh
# config the Bash tool reads at startup. Each of these is also an allowWrite target or a
# process the sandbox must exec, so denying them breaks the session outright.
read_allow=(
  "${RIBOSE_ROOT}"
  "${HOME}/.asdf" "${HOME}/.asdfrc" "${HOME}/.tool-versions" "${HOME}/.rvm"
  "${HOME}/.gem" "${HOME}/.gemrc" "${HOME}/.bundle" "${HOME}/.cache" "${HOME}/.npm"
  "${HOME}/.claude" "${HOME}/.claude.json"
  "${HOME}/.local/bin" "${HOME}/.local/share/claude" "${HOME}/.local/state"
  "${HOME}/.local/share/ruby-advisory-db"
  "${HOME}/.config/gh" "${HOME}/.gitconfig"
  "${HOME}/.zshenv" "${HOME}/.zshrc" "${HOME}/.zprofile"
  "${HOME}/.bashrc" "${HOME}/.profile"
)
# git's global config can point at files elsewhere in $HOME — core.excludesfile and
# friends. Denying them is not fatal, but git warns on every invocation and silently drops
# the setting, so resolve whatever this host actually configures instead of hardcoding
# names. Only absolute paths are taken; a relative value is git-internal.
while IFS= read -r p; do
  p="${p/#\~/${HOME}}"
  [[ "$p" == /* ]] && read_allow+=("$p")
done < <({ git config --global --get-all core.excludesfile
           git config --global --get-all core.attributesfile
           git config --global --get-all core.hooksPath
           git config --global --get-all init.templateDir; } 2>/dev/null || true)

# CWL_EXTRA_READ=/path/a,/path/b re-opens more without editing this file — the read-side
# counterpart to CWL_EXTRA_DOMAINS.
if [[ -n "${CWL_EXTRA_READ:-}" ]]; then
  while IFS= read -r p; do
    [[ -n "$p" ]] && read_allow+=("$p")
  done < <(printf '%s' "${CWL_EXTRA_READ}" | tr ',' '\n')
fi

# The sandbox honours allowRead over denyRead, so the kernel layer needs only the two
# blanket denies. The Read TOOL is a permission-layer check where deny beats allow, so a
# blanket rule there could not be re-opened — enumerate its siblings instead: walk from
# /Users down to the workspace and deny everything standing beside the path.
read_denies=(/Volumes)
# At or below an allowed path — nothing to deny.
read_allowed() {
  local p="$1" a
  for a in "${read_allow[@]}"; do
    [[ "$p" == "$a" || "$p" == "$a"/* ]] && return 0
  done
  return 1
}
# A strict ancestor of one, e.g. ~/.config when only ~/.config/gh is allowed. Denying it
# would bury the allowed child (deny beats allow), so descend and deny its siblings.
read_pierce() {
  local p="$1" a
  for a in "${read_allow[@]}"; do
    [[ "${a}/" == "${p}/"* ]] && return 0
  done
  return 1
}
walk=(/Users); w=0
while (( w < ${#walk[@]} )); do
  node="${walk[w]}"; w=$(( w + 1 ))
  while IFS= read -r e; do
    read_allowed "$e" && continue
    if read_pierce "$e"; then walk+=("$e"); else read_denies+=("$e"); fi
  done < <(find "$node" -maxdepth 1 -mindepth 1 2>/dev/null)
done

# --- every other project, for the file-tool deny list ------------------------
# Deny rules take precedence over allow rules, so we cannot blanket-deny the workspace
# and re-allow the target. Instead name every sibling explicitly: other org dirs whole,
# and inside the target's own org, each sibling repo. HANDOFFS is left out — it is the
# one writable spot besides the repo.
others=()
while IFS= read -r d; do
  b="$(basename "$d")"
  [[ "$b" == "HANDOFFS" || "$b" == "$org" ]] && continue
  others+=("${RIBOSE_ROOT}/${b}")
done < <(find "${RIBOSE_ROOT}" -maxdepth 1 -mindepth 1 -type d)
while IFS= read -r d; do
  b="$(basename "$d")"
  [[ "$b" == "$repo" ]] && continue
  others+=("${RIBOSE_ROOT}/${org}/${b}")
done < <(find "${RIBOSE_ROOT}/${org}" -maxdepth 1 -mindepth 1 -type d)

# --- session settings --------------------------------------------------------
# Written to a file rather than passed inline: the deny list runs to ~100 entries.
# BSD mktemp only substitutes a trailing run of X's, so use a directory.
cfg_dir="$(mktemp -d "${TMPDIR:-/tmp}/cwl-${org}__${repo}-XXXXXX")"
cfg="${cfg_dir}/settings.json"
trap 'rm -rf "${cfg_dir}"' EXIT

extra_domains='[]'
if [[ -n "${CWL_EXTRA_DOMAINS:-}" ]]; then
  extra_domains="$(printf '%s' "${CWL_EXTRA_DOMAINS}" | tr ',' '\n' | jq -R . | jq -s -c .)"
fi

rallow_json="$(printf '%s\n' "${read_allow[@]}"  | jq -R . | jq -s -c .)"
rdeny_json="$(printf '%s\n'  "${read_denies[@]}" | jq -R . | jq -s -c .)"

printf '%s\n' "${others[@]}" | jq -R . | jq -s \
  --arg repo_path "${repo_path}" \
  --arg handoffs  "${CW_HANDOFFS}" \
  --arg home      "${HOME}" \
  --argjson extra  "${extra_domains}" \
  --argjson rallow "${rallow_json}" \
  --argjson rdeny  "${rdeny_json}" \
  '{
    model: "opus",
    includeCoAuthoredBy: false,
    env: {DISABLE_AUTOUPDATER: "1"},
    permissions: {
      # Deny beats allow, and these cover the tools the sandbox does not reach.
      # "//" marks an absolute rule, so the path follows without its leading slash.
      # An Edit rule covers every file-editing tool (Write and NotebookEdit included);
      # a Write(path) rule is rejected as unmatched, so only Edit rules are emitted.
      # A denied entry may be a plain file, which "/**" would not match, so emit the
      # bare path too. The secret dirs stay named even though /Users covers them: they
      # are the rules that must survive any later widening of the allowlist.
      deny: (map("Edit(//" + ltrimstr("/") + "/**)")
             + ($rdeny | map("Read(//" + ltrimstr("/") + ")",
                             "Read(//" + ltrimstr("/") + "/**)"))
             + (["\($home)/.ssh", "\($home)/.aws", "\($home)/.gnupg",
                 "\($home)/.config/gcloud",
                 "\($home)/.local/share/gem"] | map("Read(//" + ltrimstr("/") + "/**)"))),
      allow: ([$repo_path, $handoffs] | map("Edit(//" + ltrimstr("/") + "/**)"))
    },
    sandbox: {
      enabled: true,
      # Never silently fall back to running unsandboxed if Seatbelt is unavailable.
      failIfUnavailable: true,
      # Bash runs prompt-free inside the boundary — this is what replaces the
      # container plus --allow-dangerously-skip-permissions.
      autoAllowBashIfSandboxed: true,
      # Close the escape hatch that lets a blocked command be re-run unsandboxed.
      allowUnsandboxedCommands: false,
      # Go binaries need com.apple.trustd.agent to verify certificates; without this
      # `gh` fails with "tls: failed to verify certificate: x509: OSStatus -26276".
      enableWeakerNetworkIsolation: true,
      filesystem: {
        # Writes default to cwd + subdirectories. The repo is named anyway, because
        # /feature moves the session into .claude/worktrees/<branch> and cwd is then
        # the worktree — git there still writes to .git/worktrees/ in the main repo.
        # Keep every comment in this filter free of an apostrophe: the whole filter
        # is one single-quoted shell string, and an apostrophe closes it.
        # These add the inbox and the caches bundler needs.
        allowWrite: [$repo_path, $handoffs, "~/.asdf/installs", "~/.asdf/shims",
                     "~/.bundle", "~/.gem", "~/.cache"],
        denyWrite: ["~/.zshrc", "~/.zprofile", "~/.bashrc", "~/.profile",
                    "~/.gitconfig", "~/.config/gh", "~/.ssh"],
        # Nothing under /Users or /Volumes is readable except allowRead, which the
        # sandbox applies with precedence over denyRead. System paths (/usr, /opt,
        # /Library, /private) stay readable — that is the toolchain, not user data.
        # ~/.local/share/gem holds the RubyGems API key; the container never had it
        # either, so `gem push` fails the same way under both launchers.
        denyRead: ["/Users", "/Volumes",
                   "~/.ssh", "~/.aws", "~/.gnupg", "~/.config/gcloud",
                   "~/.local/share/gem"],
        allowRead: $rallow
      },
      network: {
        allowedDomains: ([
          "api.anthropic.com", "claude.ai", "platform.claude.com",
          "statsig.anthropic.com",
          "github.com", "*.github.com",
          "objects.githubusercontent.com", "raw.githubusercontent.com",
          "codeload.github.com",
          # Actions logs and artifacts: `gh run view --log` calls the receiver, then
          # follows a signed redirect into Azure storage. Both hosts are necessary.
          # The storage account name rotates, so it must be a wildcard.
          "*.actions.githubusercontent.com", "*.blob.core.windows.net",
          "rubygems.org", "*.rubygems.org",
          "registry.npmjs.org", "*.npmjs.org",
          # ETSI and ITU publish the standards that the relaton work refers to.
          "www.etsi.org", "www.itu.int",
          # Crossref resolves the DOI metadata that relaton needs.
          "api.crossref.org",
          # The W3C API gives the specification metadata that relaton reads.
          "api.w3.org",
          # CEN and CENELEC publish the standards that the relaton work refers to.
          "standards.cencenelec.eu",
          # OMG publishes the specifications that the relaton work refers to.
          "omg.org", "*.omg.org"
        ] + $extra)
      }
    }
  }' > "${cfg}"

# --- session environment -----------------------------------------------------
# Claude Code sources CLAUDE_ENV_FILE in the Bash shell before each command. That shell
# is inside the sandbox, so this file opens no unsandboxed channel. The session cannot
# write to cfg_dir, so it cannot change the file.
#
# Two lines make Java work, and Jing (ruby-jing) with it:
# - JAVA_HOME. The /usr/bin/java stub runs java_home, and java_home reads the sysctl
#   kern.grade_cputype. The sandbox profile does not allow that sysctl, so the stub
#   fails with "Unable to locate a Java Runtime". With JAVA_HOME set, the stub does not
#   run java_home.
# - unset JAVA_TOOL_OPTIONS. The sandbox sets it, so Java writes "Picked up
#   JAVA_TOOL_OPTIONS: ..." to stderr. ruby-jing reads stderr and raises on each line
#   that it does not know. The flag in the variable helps Java reach the sandbox proxy
#   only, and that path fails anyway: the proxy answers 407.
# Settings cannot unset a variable, and the sandbox sets this one after the settings env.
env_file="${cfg_dir}/env.sh"
java_home="${JAVA_HOME:-$(/usr/libexec/java_home 2>/dev/null || true)}"
{
  [[ -n "${java_home}" ]] && printf 'export JAVA_HOME=%q\n' "${java_home}"
  echo 'unset JAVA_TOOL_OPTIONS'
} > "${env_file}"

# --- output style ------------------------------------------------------------
# Appended to the system prompt so every session answers the same way: ASD-STE100
# Simplified Technical English (the aerospace controlled-language standard — approved
# vocabulary, one meaning per word, short active sentences), plus a definition for any
# term the user has not used yet. The quoted heredoc delimiter keeps the text literal,
# so no shell expansion happens inside it. The identifier carve-out matters: without it
# STE rewriting mangles code, paths and command output.
style_prompt="$(cat <<'STE'
Write all conversational output in ASD-STE100 Simplified Technical English.
Use the approved STE vocabulary. Give each word one meaning and one part of speech.
Write short sentences: a maximum of 20 words for an instruction, 25 for a description.
Write one instruction in each sentence. Use the active voice.
Use the imperative mood for instructions. Use simple verb tenses.
Do not use a gerund or a participle as a noun or an adjective.
Keep a paragraph to a maximum of 6 sentences. Keep the articles a, an and the.
Do not remove words to make a sentence shorter.
Technical names and technical verbs from the code are approved words: never rewrite an
identifier, a path, a command, a flag, or quoted output.
Keep the output concise. Do not write a preamble or a recap.
When you use a term that the user did not use before in this conversation, give a
definition of one line at the first use.
STE
)"

# --- run the queued worktree drops -------------------------------------------
# This runs outside the sandbox, so it re-checks every claim the session made: the path
# lies inside this repo's own worktree directory, git still registers it as a worktree
# here, and the worktree is clean. `git worktree remove` never gets --force, so git
# keeps its own veto as well. The queue is consumed on every run, answered or not — the
# next session's Step 1 sweep finds anything that is still there.
process_drops() {
  [[ -s "${CW_DROPS}" ]] || { rm -f "${CW_DROPS}"; return 0; }

  local wt=() br=() mg=() seen=""
  local path branch state answer i
  while IFS=$'\t' read -r path branch state || [[ -n "${path}" ]]; do
    [[ -n "${path}" && -n "${branch}" ]] || continue
    case "${seen}" in *"|${path}|"*) continue ;; esac
    seen="${seen}|${path}|"
    case "${path}" in
      "${repo_path}/.claude/worktrees/"*) ;;
      *) echo "cwl: skipped ${path} — outside ${repo_path}/.claude/worktrees" >&2; continue ;;
    esac
    git -C "${repo_path}" worktree list --porcelain 2>/dev/null \
      | grep -qxF "worktree ${path}" \
      || { echo "cwl: skipped ${branch} — git does not list it as a worktree here" >&2; continue; }
    if [[ -n "$(git -C "${path}" status --porcelain 2>/dev/null)" ]]; then
      echo "cwl: kept ${branch} — the worktree has uncommitted changes" >&2
      continue
    fi
    wt+=("${path}"); br+=("${branch}"); mg+=("${state}")
  done < "${CW_DROPS}"
  rm -f "${CW_DROPS}"

  [[ ${#wt[@]} -gt 0 ]] || return 0

  echo >&2
  echo "cwl: the session approved these worktree drops:" >&2
  for ((i = 0; i < ${#wt[@]}; i++)); do
    echo "  ${br[$i]}  ->  ${wt[$i]#"${repo_path}/"}" >&2
  done
  if [[ ! -r /dev/tty ]]; then
    echo "cwl: no terminal to confirm on — nothing was removed." >&2
    return 0
  fi
  answer=""
  read -r -p "cwl: remove them and their branches? [y/N] " answer </dev/tty || true
  case "${answer}" in
    [Yy] | [Yy][Ee][Ss]) ;;
    *) echo "cwl: nothing was removed." >&2; return 0 ;;
  esac

  for ((i = 0; i < ${#wt[@]}; i++)); do
    if git -C "${repo_path}" worktree remove "${wt[$i]}"; then
      if git -C "${repo_path}" branch -d "${br[$i]}" 2>/dev/null; then
        echo "cwl: dropped ${br[$i]}" >&2
      elif [[ "${mg[$i]}" == "merged" ]] && git -C "${repo_path}" branch -D "${br[$i]}"; then
        # A squash merge writes a new commit, so `git branch -d` cannot see the merge.
        # -D is allowed only on the gh evidence in field 3.
        echo "cwl: dropped ${br[$i]} (squash-merged)" >&2
      else
        echo "cwl: removed the worktree, kept the branch ${br[$i]} — no merge evidence" >&2
      fi
    else
      echo "cwl: kept ${wt[$i]} — git refused to remove it" >&2
    fi
  done
  git -C "${repo_path}" worktree prune
  rmdir "${repo_path}/.claude/worktrees/"*/ 2>/dev/null || true
}

# --- launch ------------------------------------------------------------------
# Plan mode is a harness-level gate: Claude cannot edit until you approve a plan.
# Unlike `cw` there is no --allow-dangerously-skip-permissions — the deny rules above
# are the boundary for the file tools, and that flag would skip them.
# --add-dir makes the whole workspace readable, restoring the container's `/work:ro`
# context. Writes are still confined: the sandbox limits Bash to the cwd, and the Edit
# deny rules above cover the file tools.
cmd=(env "CLAUDE_ENV_FILE=${env_file}" claude --settings "${cfg}" --add-dir "${RIBOSE_ROOT}" --permission-mode plan --append-system-prompt "${style_prompt}")
[[ -n "$task" ]] && cmd+=("/feature ${task}")

echo "cwl: project=${target}  (no container; writes confined to this repo plus ${CW_HANDOFFS})" >&2
[[ -n "$task" ]] && echo "cwl: task=${task}" >&2

cd "${repo_path}"

# CWL_DRY_RUN=1 prints the resolved boundary and launch line instead of starting a
# session — useful for checking the config without burning a session.
if [[ -n "${CWL_DRY_RUN:-}" ]]; then
  echo "cwl: cwd=${PWD}"
  echo "cwl: settings:"
  jq '.permissions.deny |= (.[0:3] + ["... \(length - 3) more"])' "${cfg}" | sed 's/^/  /'
  echo "cwl: env file:"
  sed 's/^/  /' "${env_file}"
  echo "cwl: drops queue: ${CW_DROPS}"
  echo "cwl: launch: ${cmd[*]}"
  # Keep the generated settings so they can be inspected or reused for testing.
  trap - EXIT
  echo "cwl: settings kept at ${cfg}"
  exit 0
fi

# Finish the drops a previous session left behind, then start the session. The launcher
# no longer uses `exec`: it must stay alive to run the queue after the session ends. The
# EXIT trap therefore runs too, so the generated settings no longer leak.
process_drops

rc=0
"${cmd[@]}" || rc=$?
process_drops
exit "${rc}"
