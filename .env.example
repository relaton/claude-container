# Copy to `.env` and fill what you need. `bin/cw` reads this file and passes the
# values into the session; a variable already exported in your shell wins.
# `cw` passes the host's GitHub token as GH_TOKEN (read via `gh auth token`), so
# pushes work without setting one here. Set a Claude auth fallback only if you do
# not want to run `claude login` inside the container.

# Private gems (GitHub Packages). Already exported on the host in this setup;
# set it here too if your shell does not export it.
# BUNDLE_RUBYGEMS__PKG__GITHUB__COM=ghp_xxx

# Claude Code auth fallback (pick ONE) — instead of `claude login`:
#   long-lived token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=
#   or a raw API key:
# ANTHROPIC_API_KEY=

# GitHub token fallback (only if `gh auth token` gives nothing on the host):
# GH_TOKEN=
